rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Helpers
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Zero-lookup admin check for list queries (Cost-Optimization Clause)
    function isBootstrappedSuperAdmin() {
      return isVerifiedEmail() && request.auth.token.email == 'rishabhjaiswal335@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedSuperAdmin() || (
        isVerifiedEmail() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // 3. Entity Validation Blueprints (Anti-Update-Gap)
    function isValidPublicProfile(data) {
      return data.keys().hasAll([
        'uid', 'username', 'fullName', 'bio', 'vibeStatus', 'avatarUrl',
        'isVerified', 'role', 'followersCount', 'followingCount', 'postsCount',
        'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'uid', 'username', 'fullName', 'bio', 'vibeStatus', 'avatarUrl',
        'isVerified', 'role', 'followersCount', 'followingCount', 'postsCount',
        'createdAt', 'updatedAt'
      ])
      && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
      && data.username is string && data.username.size() >= 3 && data.username.size() <= 30 && data.username.matches('^[a-z0-9._]+$')
      && data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 60
      && data.bio is string && data.bio.size() <= 240
      && data.vibeStatus is string && data.vibeStatus.size() <= 80
      && data.avatarUrl is string && data.avatarUrl.size() <= 500
      && data.isVerified is bool
      && data.role in ['user', 'admin', 'super_admin']
      && data.followersCount is int && data.followersCount >= 0
      && data.followingCount is int && data.followingCount >= 0
      && data.postsCount is int && data.postsCount >= 0
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidPrivateUserInfo(data) {
      return data.keys().hasAll(['uid', 'email', 'phone', 'hasRated', 'createdAt', 'updatedAt'])
      && data.keys().hasOnly(['uid', 'email', 'phone', 'hasRated', 'createdAt', 'updatedAt'])
      && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
      && data.email is string && data.email.size() <= 160
      && data.phone is string && data.phone.size() <= 32
      && data.hasRated is bool
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidAppRating(data) {
      return data.keys().hasAll(['userId', 'username', 'rating', 'tags', 'feedback', 'createdAt', 'updatedAt'])
      && data.keys().hasOnly(['userId', 'username', 'rating', 'tags', 'feedback', 'createdAt', 'updatedAt'])
      && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$')
      && data.username is string && data.username.size() >= 1 && data.username.size() <= 40
      && data.rating is int && data.rating >= 1 && data.rating <= 5
      && data.tags is list && data.tags.size() <= 6 && (data.tags.size() == 0 || (data.tags[0] is string && data.tags[0].size() <= 32))
      && data.feedback is string && data.feedback.size() <= 500
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidFollow(data) {
      return data.keys().hasAll(['followerId', 'followingId', 'status', 'createdAt', 'updatedAt'])
      && data.keys().hasOnly(['followerId', 'followingId', 'status', 'createdAt', 'updatedAt'])
      && data.followerId is string && data.followerId.size() >= 1 && data.followerId.size() <= 128 && data.followerId.matches('^[a-zA-Z0-9_\\-]+$')
      && data.followingId is string && data.followingId.size() >= 1 && data.followingId.size() <= 128 && data.followingId.matches('^[a-zA-Z0-9_\\-]+$')
      && data.followerId != data.followingId
      && data.status in ['accepted', 'pending']
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidAdminRecord(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt'])
      && data.keys().hasOnly(['uid', 'email', 'role', 'createdAt'])
      && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
      && data.email is string && data.email.size() <= 160
      && data.role in ['admin', 'super_admin']
      && data.createdAt is timestamp;
    }

    function isValidAnnouncement(data) {
      return data.keys().hasAll(['title', 'body', 'bannerType', 'isActive', 'createdBy', 'createdAt'])
      && data.keys().hasOnly(['title', 'body', 'bannerType', 'isActive', 'createdBy', 'createdAt'])
      && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
      && data.body is string && data.body.size() >= 1 && data.body.size() <= 500
      && data.bannerType in ['info', 'warning', 'festival']
      && data.isActive is bool
      && data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 && data.createdBy.matches('^[a-zA-Z0-9_\\-]+$')
      && data.createdAt is timestamp;
    }

    // 4. Collection Rules
    match /users/{userId} {
      allow get: if isValidId(userId) && isSignedIn();
      allow list: if isSignedIn() && (existing().uid == request.auth.uid || isBootstrappedSuperAdmin());

      allow create: if isVerifiedEmail()
        && isValidId(userId)
        && isOwner(userId)
        && isValidPublicProfile(incoming())
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (isAdmin() || (incoming().role == 'user' && incoming().isVerified == false && incoming().followersCount == 0 && incoming().followingCount == 0 && incoming().postsCount == 0));

      allow update: if isSignedIn()
        && isValidId(userId)
        && isValidPublicProfile(incoming())
        && (
          (isAdmin() && incoming().uid == existing().uid && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time && incoming().diff(existing()).affectedKeys().hasOnly(['username', 'fullName', 'bio', 'vibeStatus', 'avatarUrl', 'isVerified', 'role', 'followersCount', 'followingCount', 'postsCount', 'updatedAt'])) ||
          (isVerifiedEmail() && isOwner(userId) && incoming().uid == existing().uid && incoming().role == existing().role && incoming().isVerified == existing().isVerified && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time && incoming().diff(existing()).affectedKeys().hasOnly(['username', 'fullName', 'bio', 'vibeStatus', 'avatarUrl', 'updatedAt']))
        );

      allow delete: if isAdmin() && isValidId(userId);

      // Split Collection PII Isolation
      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && ((isSignedIn() && existing().uid == request.auth.uid) || isBootstrappedSuperAdmin());

        allow create: if isVerifiedEmail()
          && isValidId(userId)
          && isValidId(docId)
          && docId == 'info'
          && isOwner(userId)
          && isValidPrivateUserInfo(incoming())
          && incoming().uid == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && (exists(/databases/$(database)/documents/users/$(userId)) || existsAfter(/databases/$(database)/documents/users/$(userId)));

        allow update: if isSignedIn()
          && isValidId(userId)
          && isValidId(docId)
          && docId == 'info'
          && isValidPrivateUserInfo(incoming())
          && exists(/databases/$(database)/documents/users/$(userId))
          && (
            (isAdmin() && incoming().uid == existing().uid && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'phone', 'hasRated', 'updatedAt'])) ||
            (isVerifiedEmail() && isOwner(userId) && incoming().uid == existing().uid && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'phone', 'hasRated', 'updatedAt']))
          );

        allow delete: if isAdmin() && isValidId(userId) && isValidId(docId);
      }
    }

    match /app_ratings/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if (isSignedIn() && existing().userId == request.auth.uid) || isBootstrappedSuperAdmin();

      allow create: if isVerifiedEmail()
        && isValidId(userId)
        && isOwner(userId)
        && isValidAppRating(incoming())
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(userId)
        && isValidAppRating(incoming())
        && (
          (isAdmin() && incoming().userId == existing().userId && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time && incoming().diff(existing()).affectedKeys().hasOnly(['rating', 'tags', 'feedback', 'updatedAt'])) ||
          (isVerifiedEmail() && isOwner(userId) && incoming().userId == existing().userId && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time && incoming().diff(existing()).affectedKeys().hasOnly(['rating', 'tags', 'feedback', 'updatedAt']))
        );

      allow delete: if isAdmin() && isValidId(userId);
    }

    match /follows/{followId} {
      allow get: if isValidId(followId) && isSignedIn() && (existing().followerId == request.auth.uid || existing().followingId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().followerId == request.auth.uid || existing().followingId == request.auth.uid || isBootstrappedSuperAdmin());

      allow create: if isVerifiedEmail()
        && isValidId(followId)
        && isValidFollow(incoming())
        && incoming().followerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(followId)
        && isValidFollow(incoming())
        && (
          (isAdmin() && incoming().followerId == existing().followerId && incoming().followingId == existing().followingId && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
          (isVerifiedEmail() && existing().followingId == request.auth.uid && existing().status == 'pending' && incoming().status == 'accepted' && incoming().followerId == existing().followerId && incoming().followingId == existing().followingId && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
        );

      allow delete: if isValidId(followId) && isSignedIn() && (existing().followerId == request.auth.uid || isAdmin());
    }

    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isBootstrappedSuperAdmin();

      allow create: if isAdmin()
        && isValidId(userId)
        && isValidAdminRecord(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time;

      allow update: if isAdmin()
        && isValidId(userId)
        && isValidAdminRecord(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'role']);

      allow delete: if isAdmin() && isValidId(userId);
    }

    match /announcements/{announcementId} {
      allow get: if isValidId(announcementId) && (existing().isActive == true || isAdmin());
      allow list: if existing().isActive == true || isBootstrappedSuperAdmin();

      allow create: if isAdmin()
        && isValidId(announcementId)
        && isValidAnnouncement(incoming())
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time;

      allow update: if isAdmin()
        && isValidId(announcementId)
        && isValidAnnouncement(incoming())
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'body', 'bannerType', 'isActive']);

      allow delete: if isAdmin() && isValidId(announcementId);
    }

    match /test/{docId} {
      allow get: if docId == 'connection';
    }
  }
}
